{
  "framework": null,
  "buildCommand": "node tools/bajar-recursos.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/b",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "losgomosos.lat"
        }
      ],
      "destination": "/nueva",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.losgomosos.lat"
        }
      ],
      "destination": "/nueva",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tiendavital.lat"
        }
      ],
